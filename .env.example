# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Auth.js (next-auth)
# ---------------------------------------------------------------------------
# Generate a strong secret: openssl rand -base64 32
AUTH_SECRET=

# Auth0 - https://manage.auth0.com → Applications → Create Application
# Application type: Regular Web Application
# Allowed Callback URLs: http://localhost:3000/api/auth/callback/auth0
# Allowed Logout URLs:   http://localhost:3000
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ISSUER=https://YOUR_TENANT.auth0.com

# App URL (no trailing slash)
# Local dev:
NEXTAUTH_URL=http://localhost:3000
# Production: https://splita.co.za

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
# Production: https://api.splita.co.za

# Shared secret sent to the Go API on auth sync (must match INTERNAL_SERVICE_SECRET on the backend)
# Generate: openssl rand -base64 32
INTERNAL_SERVICE_SECRET=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://splita.co.za

# ---------------------------------------------------------------------------
# Google Analytics
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=G-QT6B4DHY8W

# ---------------------------------------------------------------------------
# Contact / Waitlist form
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/XXXXXXXX

# ---------------------------------------------------------------------------
# Donations (PayFast)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_PAYFAST_URL=https://www.payfast.co.za/eng/process?merchant_id=...
# NEXT_PUBLIC_PAYFAST_MERCHANT_ID=
# NEXT_PUBLIC_PAYFAST_MERCHANT_KEY=

