# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Auth.js (next-auth)
# ---------------------------------------------------------------------------
# Generate a strong secret: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com → APIs & Services → Credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Twitter / X OAuth — https://developer.x.com → Projects & Apps → Create App
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# Facebook OAuth — https://developers.facebook.com → My Apps → Create App
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# App URL (no trailing slash)
# Local dev:
NEXTAUTH_URL=http://localhost:3000
# Production: https://splita.co.za

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
# Production: https://api.splita.co.za

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://splita.co.za

# ---------------------------------------------------------------------------
# Contact / Waitlist form
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/XXXXXXXX

# ---------------------------------------------------------------------------
# Donations (PayFast)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_PAYFAST_URL=https://www.payfast.co.za/eng/process?merchant_id=...
# NEXT_PUBLIC_PAYFAST_MERCHANT_ID=
# NEXT_PUBLIC_PAYFAST_MERCHANT_KEY=

